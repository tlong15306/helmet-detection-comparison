# Dataset and generated artifacts
# Giữ tài liệu cấu trúc trong Git, bỏ qua toàn bộ dataset/tệp nén cục bộ.
data/raw/edgevision/*
!data/raw/edgevision/.gitkeep
!data/raw/edgevision/README.md
data/processed/edgevision/*
!data/processed/edgevision/.gitkeep
!data/processed/edgevision/README.md
data/splits/*.json
data/samples/annotated_examples/*
data/samples/invalid_examples/*
!data/samples/annotated_examples/.gitkeep
!data/samples/invalid_examples/.gitkeep

# Challenge Set v1: ảnh/video nguồn và preview chỉ lưu cục bộ.
# Manifest, annotation COCO và metadata được giữ trong Git để tái lập được.
data/challenge/raw/*
!data/challenge/raw/.gitkeep
data/challenge/candidates/*
!data/challenge/candidates/.gitkeep
data/challenge/selected/*
!data/challenge/selected/.gitkeep
data/challenge/previews/*
!data/challenge/previews/.gitkeep

